# Copy to .env.development (npm run dev) or .env.production (npm run build / package).
# electron-vite chỉ tự load biến MAIN_VITE_/VITE_; app còn đọc thêm .env* qua electron/main/load-env.ts

# --- Development only (npm run dev) ---
# Dữ liệu app mặc định: ~/.ai-switcher-dev/
# Codex live config mặc định: ~/.ai-switcher-dev/.codex/
# OpenCode config mặc định: ~/.ai-switcher-dev/opencode/
# Bật đồng bộ Antigravity IDE thật khi dev (mặc định: tắt):
# AI_SWITCHER_APPLY_ANTIGRAVITY_IDE=1
# Bật đồng bộ GitHub Copilot vào VS Code/Cursor khi dev (mặc định: tắt):
# AI_SWITCHER_APPLY_COPILOT_IDE=1

# --- Overrides (cả dev & prod) ---
# AI_SWITCHER_ENV=development
# AI_SWITCHER_DATA_DIR=/custom/path
# CODEX_HOME=/custom/.codex
# OPENCODE_CONFIG_DIR=/custom/opencode

# Antigravity Google OAuth credentials.
# Mặc định app tải từ opencode-antigravity-auth khi đăng nhập.
# Chỉ đặt khi cần offline OAuth hoặc custom OAuth app.
# See: https://github.com/NoeFabris/opencode-antigravity-auth/blob/main/src/constants.ts
ANTIGRAVITY_CLIENT_ID=
ANTIGRAVITY_CLIENT_SECRET=
