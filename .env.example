# Optional: Antigravity Google OAuth credentials.
# By default the app loads these from opencode-antigravity-auth at runtime.
# Set both values only if you need offline OAuth login or a custom OAuth app.
# See: https://github.com/NoeFabris/opencode-antigravity-auth/blob/main/src/constants.ts
ANTIGRAVITY_CLIENT_ID=
ANTIGRAVITY_CLIENT_SECRET=
